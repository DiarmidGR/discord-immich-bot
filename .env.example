# Discord bot token (Discord Developer Portal -> your app -> Bot -> Token)
DISCORD_TOKEN=

# Comma-separated list of Discord channel IDs to watch.
# Right-click a channel in Discord (with Developer Mode enabled) -> Copy Channel ID.
WATCHED_CHANNEL_IDS=

# Your Immich server's base URL, no trailing slash, no /api suffix.
IMMICH_URL=

# Immich API key (Immich web UI -> Account Settings -> API Keys)
IMMICH_API_KEY=

# Optional: JSON map of channel ID -> album name, for channels where you don't
# want the album to just be the channel's name. Any watched channel not listed
# here falls back to its own Discord channel name.
# Example: {"123456789012345678":"Family Photos"}
CHANNEL_ALBUM_OVERRIDES={}

# Optional: minimum file size in bytes to bother uploading (skips tiny emoji/sticker-like images). Default 0 (no minimum).
MIN_IMAGE_BYTES=0

# Optional: maximum file size in bytes to upload. Useful to cap large video files.
# Default 0 (no maximum). Example: 200000000 for a 200MB cap.
MAX_MEDIA_BYTES=0
